+    const routineHashDump = await admin.query(`
+      SELECT
+        candidate.oid::pg_catalog.regprocedure::text AS signature,
+        pg_catalog.encode(
+          pg_catalog.sha256(pg_catalog.convert_to(candidate.prosrc, 'UTF8')),
+          'hex'
+        ) AS body_sha256,
+        pg_catalog.encode(
+          pg_catalog.sha256(
+            pg_catalog.convert_to(
+              pg_catalog.pg_get_functiondef(candidate.oid),
+              'UTF8'
+            )
+          ),
+          'hex'
+        ) AS definition_sha256
+      FROM pg_catalog.pg_proc AS candidate
+      WHERE candidate.oid = ANY($1::pg_catalog.regprocedure[])
+      ORDER BY signature
+    `, [[
+      "public.lock_backup_status_mail_admin_authority()",
+      "public.enqueue_backup_status_mail_authority(text,text)",
+      "public.backup_status_mail_authorized(uuid)",
+    ]]);
+    process.stdout.write(
+      `HASH_DUMP=${JSON.stringify(routineHashDump.rows)}\n`,
+    );
+    throw new Error("HASH_DUMP_ONLY");
+
     assert.equal(
