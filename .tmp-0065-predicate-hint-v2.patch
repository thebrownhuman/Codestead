diff --git a/drizzle/0065_backup_status_mail_authority.sql b/drizzle/0065_backup_status_mail_authority.sql
--- a/drizzle/0065_backup_status_mail_authority.sql
+++ b/drizzle/0065_backup_status_mail_authority.sql
