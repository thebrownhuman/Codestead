+            ...routine,
+            definitionSha256:
+              createHash("sha256").update(definition).digest("hex"),
+            bodySha256: createHash("sha256").update(body).digest("hex"),
+          })),
+        })}\n`,
+        { encoding: "utf8", flag: "wx" },
+      );
+    } finally {
+      await catalogClient.end().catch(() => undefined);
+    }
