[Unit]
Description=Check LearnCoding PostgreSQL accepts connections
Documentation=/opt/learncoding/docs/runbooks/logs-and-monitoring.md
OnFailure=learncoding-alert@%n.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/bash /opt/learncoding/infra/ops/check-postgres.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0077
TimeoutStartSec=60
