+run_compose_managed() {
+  local allotted_seconds="${1:-}"
+  shift || return 125
+  local args=(docker compose)
+  if [[ -f "$COMPOSE_ENV_FILE" ]]; then
+    args+=(--env-file "$COMPOSE_ENV_FILE")
+  fi
+  args+=(-f "$REPO_ROOT/compose.yaml")
+  run_managed_backup_command "$allotted_seconds" "${args[@]}" "$@"
+}
